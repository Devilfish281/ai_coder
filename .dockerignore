# Git history and local Git metadata
.git
.gitignore

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging output
build/
dist/
*.egg-info/

# Local environment and secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx

# Local logs and runtime output
var/
logs/
*.log

# RALPH temporary worktrees and generated runtime files
.ralph/worktrees/
.ralph/tmp/
.ralph/logs/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node artifacts, in case they appear later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large or generated archives
*.zip
*.tar
*.tar.gz
*.7z
